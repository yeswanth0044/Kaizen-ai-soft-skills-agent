# GEMINI_API_KEY: Required for server-side Gemini AI coaching, mock interviews, and feedback evaluation.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
